.hero {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  text-align: center;
}

.hero .lbl {
  font-size: 23rpx;
  color: #9ca3af;
}

.hero .amount {
  font-size: 64rpx;
  font-weight: 500;
  color: #e5484d;
  margin: 10rpx 0 18rpx;
}

.reason {
  margin-top: 14rpx;
  font-size: 27rpx;
  color: #4b5563;
  line-height: 1.7;
}
