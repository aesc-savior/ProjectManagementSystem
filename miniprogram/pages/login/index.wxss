.login {
  min-height: 100vh;
  padding: 120rpx 48rpx 60rpx;
  background: linear-gradient(180deg, #eef4ff 0%, #f4f6f8 42%);
}

.brand {
  text-align: center;
  margin-bottom: 60rpx;
}

.logo {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 24rpx;
  border-radius: 32rpx;
  background: #2f6fed;
  color: #fff;
  font-size: 52rpx;
  line-height: 120rpx;
  font-weight: 500;
}

.name {
  font-size: 40rpx;
  font-weight: 500;
  color: #1f2937;
}

.slogan {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8a94a6;
}

.login-card {
  background: #fff;
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
}

.checking {
  padding: 40rpx 0;
  text-align: center;
  color: #8a94a6;
  font-size: 26rpx;
}

.form-item .ph {
  color: #b6bdc9;
}

.error-text {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  background: #fdeceb;
  border-radius: 12rpx;
  color: #e5484d;
  font-size: 24rpx;
}

.reconnect {
  text-align: center;
}

.foot {
  margin-top: 40rpx;
  text-align: center;
}

.link {
  font-size: 22rpx;
  color: #b6bdc9;
}
