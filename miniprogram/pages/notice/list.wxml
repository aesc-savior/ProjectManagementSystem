<view class="page">
  <view class="banner" wx:if="{{unsigned > 0}}">还有 {{unsigned}} 条公告未签收，点开即可签收</view>

  <block wx:if="{{loaded && !list.length}}">
    <mp-empty text="{{error ? '加载失败' : '暂无公告'}}" sub="{{error}}"
              action="{{error ? '重试' : ''}}" bind:action="resetList" />
  </block>

  <view class="item" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="toDetail">
    <view class="item-top">
      <view class="item-title">{{item.title}}</view>
      <mp-tag text="{{item.signedText}}" type="{{item.signedType}}" />
    </view>
    <view class="item-meta">
      <text>{{item.scopeText}}</text>
      <text>{{item.publisher}}</text>
      <text>{{item.timeText}}</text>
    </view>
    <view class="item-foot">
      <text>已签收 {{item.readCount}} 人</text>
      <text class="more">查看 ›</text>
    </view>
  </view>

  <mp-loadmore loading="{{loading}}" hasMore="{{hasMore}}" total="{{total}}" />
</view>
