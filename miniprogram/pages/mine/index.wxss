.profile {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: #2f6fed;
  color: #fff;
  font-size: 44rpx;
  line-height: 108rpx;
  text-align: center;
  margin-right: 24rpx;
}

.name {
  font-size: 34rpx;
  font-weight: 500;
}

.sub {
  font-size: 23rpx;
  color: #9ca3af;
  margin-top: 4rpx;
}

.entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #eef1f5;
  font-size: 28rpx;
}

.entry:last-child {
  border-bottom: none;
}

.entry .arrow {
  color: #c3cbd8;
  font-size: 32rpx;
}
