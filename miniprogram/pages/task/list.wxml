<view class="page">
  <view class="tabs">
    <view wx:for="{{tabs}}" wx:key="key" class="tab {{status === item.key ? 'active' : ''}}"
          data-key="{{item.key}}" bindtap="onTab">{{item.text}}</view>
  </view>

  <view class="filter-row">
    <view class="chip {{mine ? 'on' : ''}}" bindtap="onToggleMine">
      {{mine ? '✓ 只看我的' : '只看我的'}}
    </view>
    <view wx:if="{{projectName}}" class="chip on" bindtap="clearProject">
      项目：{{projectName}} ×
    </view>
    <view class="search flex1">
      <input value="{{keyword}}" bindinput="onKeyword" placeholder="搜索任务标题" placeholder-class="ph" />
    </view>
  </view>

  <block wx:if="{{loaded && !list.length}}">
    <mp-empty text="{{error ? '加载失败' : '没有符合条件的任务'}}" sub="{{error}}"
              action="{{error ? '重试' : ''}}" bind:action="resetList" />
  </block>

  <view class="item" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="toDetail">
    <view class="item-top">
      <view class="item-title">{{item.title}}</view>
      <mp-tag text="{{item.statusText}}" type="{{item.statusType}}" />
    </view>
    <view class="item-meta">
      <text>{{item.projectName}}</text>
      <text>{{item.assignee}}</text>
      <text wx:if="{{item.overdueText}}" class="danger-text">{{item.overdueText}}</text>
      <text wx:else>截止 {{item.dueText}}</text>
    </view>
    <view class="progress-row">
      <view class="progress flex1">
        <view class="progress-inner {{item.progress >= 100 ? 'done' : ''}}" style="width:{{item.progress}}%"></view>
      </view>
      <text class="pct">{{item.progress}}%</text>
    </view>
    <view class="item-foot">
      <mp-tag text="优先级 {{item.priorityText}}" type="{{item.priorityType}}" />
      <text class="more">更新进度 ›</text>
    </view>
  </view>

  <mp-loadmore loading="{{loading}}" hasMore="{{hasMore}}" total="{{total}}" />
</view>
