.tabs .tab {
  position: relative;
}

.tabs .dot {
  display: inline-block;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  margin-left: 6rpx;
  border-radius: 15rpx;
  background: #e5484d;
  color: #fff;
  font-size: 20rpx;
  line-height: 30rpx;
  text-align: center;
  vertical-align: 2rpx;
}

.apply-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  margin-bottom: 20rpx;
}

.date-compare {
  display: flex;
  align-items: center;
  background: #f7f9fc;
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  margin-top: 16rpx;
}

.date-compare .cell {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.date-compare .lbl {
  font-size: 22rpx;
  color: #9ca3af;
}

.date-compare .val {
  font-size: 27rpx;
  margin-top: 4rpx;
}

.date-compare .arrow {
  color: #c3cbd8;
  margin: 0 16rpx;
}

.reason {
  margin-top: 14rpx;
  line-height: 1.6;
}
