.date-compare {
  display: flex;
  align-items: center;
  background: #f7f9fc;
  border-radius: 16rpx;
  padding: 22rpx 20rpx;
  margin-top: 16rpx;
}

.date-compare .cell {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.date-compare .lbl {
  font-size: 22rpx;
  color: #9ca3af;
}

.date-compare .val {
  font-size: 30rpx;
  margin-top: 6rpx;
}

.date-compare .arrow {
  color: #c3cbd8;
  margin: 0 16rpx;
}

.reason {
  margin-top: 14rpx;
  font-size: 27rpx;
  color: #4b5563;
  line-height: 1.7;
}
