.mp-tag {
  display: inline-block;
  padding: 2rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  line-height: 34rpx;
  background: #f2f4f7;
  color: #6b7280;
  white-space: nowrap;
}

.mp-tag-primary {
  background: #eaf1fe;
  color: #2f6fed;
}

.mp-tag-success {
  background: #e9f7ee;
  color: #16a34a;
}

.mp-tag-warn {
  background: #fdf3e3;
  color: #d97706;
}

.mp-tag-danger {
  background: #fdeceb;
  color: #e5484d;
}

.mp-tag-info {
  background: #eef2ff;
  color: #4f46e5;
}
