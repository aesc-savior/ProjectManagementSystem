.mp-empty {
  padding: 90rpx 40rpx;
  text-align: center;
}

.mp-empty-art {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 24rpx;
  border-radius: 50%;
  background: #eef1f5;
  position: relative;
}

.mp-empty-art::after {
  content: '';
  position: absolute;
  left: 38rpx;
  top: 44rpx;
  width: 44rpx;
  height: 10rpx;
  border-radius: 6rpx;
  background: #cfd6e0;
}

.mp-empty-text {
  font-size: 27rpx;
  color: #9ca3af;
}

.mp-empty-sub {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #b6bdc9;
}

.mp-empty-btn {
  display: inline-block;
  margin-top: 26rpx;
  padding: 0 32rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 32rpx;
  background: #eaf1fe;
  color: #2f6fed;
  font-size: 25rpx;
}
