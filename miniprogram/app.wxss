/* ============================================================
 * 全局样式：一次定义，页面只写结构
 * 设计口径：浅灰底 + 白卡片 + 单一主色（#2f6fed），圆角 24rpx
 * ============================================================ */

page {
  --brand: #2f6fed;
  --brand-soft: #eaf1fe;
  --ink: #1f2937;
  --ink-2: #6b7280;
  --ink-3: #9ca3af;
  --line: #eef1f5;
  --bg: #f4f6f8;
  --danger: #e5484d;
  --danger-soft: #fdeceb;
  --warn: #d97706;
  --warn-soft: #fdf3e3;
  --success: #16a34a;
  --success-soft: #e9f7ee;

  background: var(--bg);
  color: var(--ink);
  font-size: 28rpx;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  line-height: 1.6;
}

view, text, input, textarea, button {
  box-sizing: border-box;
}

.page {
  padding: 24rpx 24rpx 40rpx;
}

/* ---------- 卡片 ---------- */
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.card-sub {
  font-size: 24rpx;
  color: var(--ink-3);
}

.divider {
  height: 1rpx;
  background: var(--line);
  margin: 24rpx 0;
}

/* ---------- 键值行 ---------- */
.row {
  display: flex;
  align-items: flex-start;
  padding: 14rpx 0;
  font-size: 27rpx;
}

.row .k {
  width: 168rpx;
  flex: none;
  color: var(--ink-3);
}

.row .v {
  flex: 1;
  color: var(--ink);
  word-break: break-all;
}

.row .v.mono {
  font-family: Menlo, Consolas, monospace;
  font-size: 25rpx;
}

/* ---------- 列表 ---------- */
.item {
  background: #fff;
  border-radius: 24rpx;
  padding: 26rpx;
  margin-bottom: 20rpx;
}

.item-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.item-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 500;
  margin-right: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-meta {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--ink-3);
}

.item-meta text {
  margin-right: 20rpx;
}

.item-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--line);
  font-size: 24rpx;
  color: var(--ink-2);
}

/* ---------- 按钮 ---------- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  border-radius: 16rpx;
  font-size: 29rpx;
  background: #f2f4f7;
  color: var(--ink-2);
}

.btn-primary {
  background: var(--brand);
  color: #fff;
}

.btn-danger {
  background: var(--danger-soft);
  color: var(--danger);
}

.btn-plain {
  background: #fff;
  border: 1rpx solid var(--line);
  color: var(--ink-2);
}

.btn-sm {
  height: 60rpx;
  padding: 0 24rpx;
  font-size: 25rpx;
  border-radius: 12rpx;
}

.btn[disabled],
.btn.disabled {
  opacity: 0.5;
}

.btn-row {
  display: flex;
  gap: 20rpx;
}

.btn-row .btn {
  flex: 1;
}

/* ---------- 搜索与筛选 ---------- */
.search {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 0 24rpx;
  height: 76rpx;
  margin-bottom: 20rpx;
}

.search input {
  flex: 1;
  font-size: 27rpx;
  height: 76rpx;
}

.search .ph {
  color: var(--ink-3);
  font-size: 27rpx;
}

.tabs {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
}

.tabs .tab {
  flex: 1;
  text-align: center;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 27rpx;
  color: var(--ink-2);
  border-radius: 12rpx;
}

.tabs .tab.active {
  background: var(--brand-soft);
  color: var(--brand);
  font-weight: 500;
}

/* ---------- 表单 ---------- */
.form-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  font-size: 25rpx;
  color: var(--ink-3);
  margin-bottom: 10rpx;
}

.form-input,
.form-textarea {
  width: 100%;
  font-size: 29rpx;
  color: var(--ink);
}

.form-textarea {
  height: 160rpx;
}

.form-readonly {
  font-size: 29rpx;
  color: var(--ink);
}

/* ---------- 进度条 ---------- */
.progress {
  height: 10rpx;
  background: #eef1f5;
  border-radius: 10rpx;
  overflow: hidden;
  margin-top: 14rpx;
}

.progress-inner {
  height: 100%;
  background: var(--brand);
  border-radius: 10rpx;
}

.progress-inner.done {
  background: var(--success);
}

/* ---------- 工作台数字 ---------- */
.stat-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.stat {
  width: calc(50% - 10rpx);
  background: #fff;
  border-radius: 24rpx;
  padding: 26rpx;
}

.stat .num {
  font-size: 44rpx;
  font-weight: 500;
  color: var(--ink);
}

.stat .num.brand {
  color: var(--brand);
}

.stat .num.danger {
  color: var(--danger);
}

.stat .lbl {
  font-size: 24rpx;
  color: var(--ink-3);
  margin-top: 4rpx;
}

/* ---------- 其他 ---------- */
.hint {
  font-size: 23rpx;
  color: var(--ink-3);
}

.danger-text {
  color: var(--danger);
}

.brand-text {
  color: var(--brand);
}

.mt8 { margin-top: 8rpx; }
.mt16 { margin-top: 16rpx; }
.mt24 { margin-top: 24rpx; }
.mb0 { margin-bottom: 0; }
.bold { font-weight: 500; }
.right { text-align: right; }
.center { text-align: center; }
.flex1 { flex: 1; }

.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid var(--line);
  display: flex;
  gap: 20rpx;
}

.footer-bar .btn {
  flex: 1;
}

.footer-space {
  height: 140rpx;
}
